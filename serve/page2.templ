package serve 

templ page2() {
  <!DOCTYPE html>
  <html lang="en">
  <head>
      <meta charset="UTF-8">
      <meta name="viewport" content="width=device-width, initial-scale=1.0">
      <title>Timeline and Summary</title>
      <style>
          body {
              font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
              line-height: 1.6;
              margin: 0;
              padding: 20px;
              background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
              min-height: 100vh;
          }
          
          .container {
              max-width: 1200px;
              margin: 0 auto;
          }
          
          .main-grid {
              display: grid;
              grid-template-columns: 2fr 1fr;
              gap: 30px;
          }
          
          .card {
              background: rgba(255, 255, 255, 0.95);
              backdrop-filter: blur(10px);
              border-radius: 15px;
              padding: 25px;
              box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
          }
          
          .card h3 {
              margin: 0 0 20px 0;
              color: #2c3e50;
              font-size: 1.3em;
          }
          
          /* Timeline View */
          .timeline {
              position: relative;
          }
          
          .timeline-item {
              display: flex;
              align-items: center;
              margin: 20px 0;
              padding: 15px;
              background: #f8f9fa;
              border-radius: 10px;
              border-left: 4px solid #007acc;
              transition: all 0.3s ease;
          }
          
          .timeline-item:hover {
              transform: translateX(5px);
              box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
          }
          
          .timeline-time {
              font-weight: bold;
              color: #007acc;
              min-width: 80px;
          }
          
          .timeline-duration {
              background: #007acc;
              color: white;
              padding: 4px 8px;
              border-radius: 12px;
              font-size: 0.8em;
              margin: 0 15px;
          }
          
          .timeline-category {
              font-weight: 600;
              color: #2c3e50;
              margin-right: 10px;
          }
          
          /* Category Analytics */
          .category-grid {
              display: grid;
              gap: 15px;
          }
          
          .category-item {
              display: flex;
              align-items: center;
              justify-content: space-between;
              padding: 15px;
              background: linear-gradient(135deg, #667eea, #764ba2);
              color: white;
              border-radius: 10px;
              box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
          }
          
          .category-info {
              flex: 1;
          }
          
          .category-name {
              font-weight: bold;
              font-size: 1.1em;
          }
          
          .category-stats {
              font-size: 0.9em;
              opacity: 0.9;
              margin-top: 5px;
          }
          
          .category-duration {
              font-size: 1.5em;
              font-weight: bold;
              text-align: right;
          }
          
          .category-trend {
              font-size: 0.8em;
              margin-top: 5px;
          }
          
          .trend-indicator {
              display: inline-flex;
              align-items: center;
              gap: 5px;
              font-size: 0.9em;
              padding: 4px 8px;
              border-radius: 12px;
              font-weight: bold;
          }
          
          .trend-up { background: #d4edda; color: #155724; }
          .trend-down { background: #f8d7da; color: #721c24; }
      </style>
  </head>
  <body>
      <div class="container">
          <div class="main-grid">
              <div class="card">
                  <h3>Today's Timeline</h3>
                  <div class="timeline">
                      <div class="timeline-item">
                          <div class="timeline-time">07:09</div>
                          <div class="timeline-category">Deep Work</div>
                          <div>Frontend component refactoring</div>
                          <div class="timeline-duration">43m</div>
                      </div>
                      <div class="timeline-item">
                          <div class="timeline-time">08:05</div>
                          <div class="timeline-category">Break</div>
                          <div>Coffee & email check</div>
                          <div class="timeline-duration">15m</div>
                      </div>
                      <div class="timeline-item">
                          <div class="timeline-time">09:30</div>
                          <div class="timeline-category">Meeting</div>
                          <div>Sprint planning & code review</div>
                          <div class="timeline-duration">90m</div>
                      </div>
                      <div class="timeline-item">
                          <div class="timeline-time">11:15</div>
                          <div class="timeline-category">Documentation</div>
                          <div>API documentation updates</div>
                          <div class="timeline-duration">25m</div>
                      </div>
                      <div class="timeline-item">
                          <div class="timeline-time">14:00</div>
                          <div class="timeline-category">Deep Work</div>
                          <div>Database optimization</div>
                          <div class="timeline-duration">2h</div>
                      </div>
                  </div>
              </div>
              
              <div class="card">
                  <h3>Summary</h3>
                  <div class="category-grid">
                      <div class="category-item">
                          <div class="category-info">
                              <div class="category-name">Deep Work</div>
                              <div class="category-stats">8 sessions • 62% of day</div>
                              <div class="category-trend trend-up">↗ +15% vs yesterday</div>
                          </div>
                          <div class="category-duration">4.5h</div>
                      </div>
                      <div class="category-item">
                          <div class="category-info">
                              <div class="category-name">Meetings</div>
                              <div class="category-stats">3 sessions • 23% of day</div>
                              <div class="category-trend trend-down">↘ -8% vs yesterday</div>
                          </div>
                          <div class="category-duration">1.7h</div>
                      </div>
                      <div class="category-item">
                          <div class="category-info">
                              <div class="category-name">Documentation</div>
                              <div class="category-stats">2 sessions • 15% of day</div>
                              <div class="category-trend trend-up">↗ +22% vs yesterday</div>
                          </div>
                          <div class="category-duration">1.1h</div>
                      </div>
                  </div>
              </div>
          </div>
      </div>
  </body>
  </html>
}
