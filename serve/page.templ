package serve

import (
  "time"
	"github.com/ohhfishal/gotime/entry"
)

templ IncludeAlpine() {
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
}

templ MainPage(entries []entry.Entry) {
  <!DOCTYPE html>
  <html>
  <head>
  <title>Daily Report</title>
  <meta http-equiv="refresh" content="60">
  @IncludeAlpine()
  @QuickAddScript()
  @Style()
  </head>
  <body>

    <!-- TODO: Have this select the date to view? -->
    <h1>{ time.Now().Format(time.DateOnly) }</h1>

    <!-- TODO: Implement this with HTMX -->
    <div class="quick-add-bar">
      @QuickAddForm()
    </div>

    <div class="details">
      @Details(entries)
    </div>
  </body>
  </html>
}

templ QuickAddScript() {
  <script>
    document.addEventListener('alpine:init', () => {
      Alpine.data('entryForm', () => {
        return {
          request: {
            category:	"",
            date: "{{ time.Now().Format(time.DateOnly) }}",
            time:	"{{ time.Now().Format(`15:04`) }}",
            note:	"",
          },
          submit() {
            // TODO: Validate and trigger an htmx submit
          },
          async post() {
            // TODO: Handle errors and validation
            return await (
              await fetch("/api/v1/entry", {
                method: "POST",
                headers: {
                  "Content-Type": "application/json",
                },
                body: JSON.stringify({
                  category:	this.request.category,
                  time:	this.request.date + " " + this.request.time + ":00",
                  note:	this.request.note,
                }),
              })
            ).json();
          },
        }
      });
    });
  </script>
}

templ QuickAddForm() {
  <form class="quick-add-form" 
        x-on:submit.prevent="post"
        x-data="entryForm">
        
    <span class="label">Add Entry:</span>
    
    <input type="text" 
          x-model="request.category"
          class="category-input"
          placeholder="Category (e.g., Work, Break, Meeting...)"
          required>

    <input type="date" 
      x-model="request.date"
      required>
    
    <input type="time" 
      x-model="request.time"
      required>
    
    <input type="text" 
          x-model="request.note"
          placeholder="Add a note...">
    
    <button type="submit" class="add-btn">Add Entry</button>
  </form>
}


templ Details(entries []entry.Entry) {
  <h2>Schedule</h2>
  <table>
    <thead>
      <tr>
        <th>Category</th>
        <th>Start</th>
        <th>Length</th>
        <th>Note</th>
      </tr>
    </thead>
    <tbody>
    for _, entry := range entries {
      @ScheduleRow(entry)
    }
    </tbody>
  </table>

  <h2>Summary</h2>
  <table>
    <thead>
      <tr>
        <th>Category</th>
        <th>Length</th>
      </tr>
    </thead>
    <tbody>
      @SummaryRow()
    </tbody>
  </table>
}

// TODO: Improve formatting (tailwind css?)
// TODO: Get the length metadata populdated here
templ ScheduleRow(entry entry.Entry) {
  <tr>
    <td>{ entry.Category }</td>
    <td>{ entry.Time.Format(`15:04`) }</td>
    <td></td>
    <td>{ entry.Note }</td>
  </tr>
}


// TODO: Add the metadata here
templ SummaryRow() {
  <tr>
    <td>Example Cateogry</td>
    <td>Length</td>
  </tr>
}


templ Style() {
  <style>
    body {
      font-family: sans-serif;
      max-width: 1200px;
      margin: 0 auto;
      padding: 20px;
    }
    
    .quick-add-bar {
      background-color: #f8f9fa;
      padding: 15px;
      border-radius: 8px;
      margin-bottom: 20px;
      border: 1px solid #e9ecef;
    }
    
    .quick-add-form {
      display: flex;
      gap: 10px;
      align-items: center;
      flex-wrap: wrap;
    }
    
    .quick-add-form input, .quick-add-form select {
      padding: 8px;
      border: 1px solid #ddd;
      border-radius: 4px;
      font-size: 14px;
    }
    
    .quick-add-form input[type="text"].category-input {
      min-width: 200px;
    }
    
    .quick-add-form input[type="time"] {
      width: 120px;
    }
    
    .category-input {
      min-width: 200px;
    }
    
    .quick-add-form input[type="text"]:not(.category-input) {
      flex: 1;
      min-width: 150px;
    }
    
    .add-btn {
      background-color: #4CAF50;
      color: white;
      border: none;
      padding: 8px 16px;
      border-radius: 4px;
      cursor: pointer;
      font-size: 14px;
      transition: background-color 0.3s;
    }
    
    .add-btn:hover {
      background-color: #45a049;
    }
    
    table {
      border-collapse: collapse;
      width: 100%;
      margin-bottom: 1em;
    }
    
    th, td {
      border: 1px solid #ddd;
      padding: 8px;
      text-align: left;
    }
    
    th {
      background-color: #f2f2f2;
    }
    
    .label {
      font-weight: bold;
      color: #555;
      white-space: nowrap;
    }
    
    @media (max-width: 768px) {
      .quick-add-form {
        flex-direction: column;
        align-items: stretch;
      }
      
      .quick-add-form input,
      .quick-add-form select {
        width: 100%;
        box-sizing: border-box;
      }
    }
  </style>
}
